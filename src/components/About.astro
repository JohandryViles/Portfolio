---
import LocationGlobe from './LocationGlobe';
import SocialIcon from './SocialIcon.astro';
import { site, stackGroups } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const titleKey: Record<(typeof stackGroups)[number]['id'], UiKey> = {
  tech: 'stack.tech',
  databases: 'stack.databases',
  tools: 'stack.tools',
};
---

<section id="about" class="relative scroll-mt-24 overflow-hidden py-14 md:py-20">
  <div
    class="pointer-events-none absolute right-[12%] top-1/2 hidden size-[28rem] -translate-y-1/2 rounded-full border border-line/40 md:block"
    aria-hidden="true"
  ></div>

  <div class="page-shell relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-10">
    <div>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
        <p class="shrink-0 text-sm text-muted">{t('about.crumb')}</p>
        <p
          class="max-w-md text-sm leading-relaxed text-muted sm:text-right md:text-base"
          set:html={t('about.intro')}
        />
      </div>

      <div class="mt-8 grid gap-3">
        {
          stackGroups.map((group) => (
            <article
              class:list={[
                'rounded-[1.4rem] border p-4 md:p-5',
                group.highlight
                  ? 'border-transparent bg-ink text-bg'
                  : 'border-line bg-transparent text-ink',
              ]}
            >
              <h3
                class:list={[
                  'text-lg font-semibold',
                  group.highlight ? 'text-bg' : 'text-ink',
                ]}
              >
                {t(titleKey[group.id])}
              </h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li
                    class:list={[
                      'rounded-full border px-3 py-1.5 text-xs leading-none',
                      group.highlight
                        ? 'border-bg/20 bg-bg/5 text-bg/80'
                        : 'border-line text-muted',
                    ]}
                  >
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="mt-5 flex items-center gap-3">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-11 place-items-center rounded-full border border-line text-ink transition-transform duration-300 hover:-translate-y-0.5"
          aria-label="GitHub"
        >
          <SocialIcon name="github" class="size-5" />
        </a>
        <a
          href={`mailto:${site.email}`}
          class="grid size-11 place-items-center rounded-full bg-ink text-bg transition-transform duration-300 hover:-translate-y-0.5"
          aria-label={t('contact.email')}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M7 17 17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <p class="mt-5 max-w-sm text-xs leading-relaxed text-muted" set:html={t('about.note')} />
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <LocationGlobe
        client:load
        eyebrow={t('location.eyebrow')}
        label={t('location.label')}
        city={t('location.city')}
        coords={t('location.coords')}
        tz={t('location.tz')}
      />
    </div>
  </div>
</section>
