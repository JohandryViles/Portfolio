---
import { projects } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const getProjectPath = (projectId: string) =>
  lang === 'es'
    ? `/es/proyectos/${projectId}`
    : `/en/projects/${projectId}`;

const accents: Record<(typeof projects)[number]['accent'], string> = {
  violet: 'from-[#f5f5f5]/35 via-[#a6a6a6]/25 to-[#3d3d3d]/80',
  teal: 'from-[#a6a6a6]/40 via-[#3d3d3d]/50 to-[#121212]/90',
  amber: 'from-[#f5f5f5]/25 via-[#3d3d3d]/60 to-[#121212]/95',
};
---

<section id="projects" class="scroll-mt-24 py-14 md:py-16" data-projects>
  <div class="page-shell">
    <div class="mb-7 flex items-end justify-between gap-4">
      <h2 class="text-3xl font-semibold text-ink md:text-4xl">{t('projects.title')}</h2>
    </div>

    <div class="project-stage" data-projects-stage>
      <button
        type="button"
        class="project-control project-control--prev"
        data-projects-prev
        aria-label={t('projects.prev')}
      >
        <span aria-hidden="true">←</span>
      </button>

      {
        projects.map((project, index) => (
          <article
            class="project-card"
            data-project-card
            data-index={index}
            data-state={index === 0 ? 'active' : index === 1 ? 'next' : 'prev'}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <div class="grid h-full min-h-[19rem] sm:grid-cols-[0.88fr_1.12fr]">
              <div
                class:list={[
                  'project-art relative min-h-40 overflow-hidden bg-gradient-to-br sm:min-h-full',
                  accents[project.accent],
                ]}
              >
                <div class="project-orb" aria-hidden="true"></div>
                <div class="project-orb project-orb--small" aria-hidden="true"></div>
              </div>
              <div class="flex flex-col justify-between p-6 md:p-7">
                <div>
                  <span class="text-xs uppercase tracking-[0.16em] text-muted">
                    {t('projects.comingSoon')}
                  </span>
                  <h3 class="mt-3 text-xl font-semibold leading-snug text-ink md:text-2xl">
                    {project.title[lang]}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-muted">
                    {project.description[lang]}
                  </p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <li class="rounded-full border border-line px-2.5 py-1 text-[0.68rem] text-muted">
                        {tag}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-6 flex items-center gap-3">
                  <a
                    href={getProjectPath(project.id)}
                    class="group inline-flex items-center gap-3 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
                  >
                    <span class="inline-flex rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]">
                      {t('projects.readMore')}
                    </span>
                    <span
                      class="grid size-10 place-items-center rounded-full border border-line text-ink transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }

      <button
        type="button"
        class="project-control project-control--next"
        data-projects-next
        aria-label={t('projects.next')}
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="mt-5 flex justify-center gap-2" aria-hidden="true">
      {
        projects.map((_, index) => (
          <span
            class:list={['project-dot', index === 0 && 'is-active']}
            data-project-dot
          ></span>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-projects]');
  const cards = Array.from(
    root?.querySelectorAll<HTMLElement>('[data-project-card]') ?? [],
  );
  const dots = Array.from(
    root?.querySelectorAll<HTMLElement>('[data-project-dot]') ?? [],
  );
  const prev = root?.querySelector<HTMLButtonElement>('[data-projects-prev]');
  const next = root?.querySelector<HTMLButtonElement>('[data-projects-next]');

  if (cards.length && prev && next) {
    let activeIndex = 0;

    const render = () => {
      cards.forEach((card, index) => {
        let state = 'hidden';

        if (index === activeIndex) {
          state = 'active';
        } else if (index === (activeIndex - 1 + cards.length) % cards.length) {
          state = 'prev';
        } else if (index === (activeIndex + 1) % cards.length) {
          state = 'next';
        }

        card.dataset.state = state;
        card.setAttribute('aria-hidden', state === 'active' ? 'false' : 'true');
        if ('inert' in card) card.inert = state !== 'active';
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });

      prev.disabled = cards.length < 2;
      next.disabled = cards.length < 2;
    };

    const move = (direction: 1 | -1) => {
      activeIndex = (activeIndex + direction + cards.length) % cards.length;
      render();
    };

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    render();
  }
</script>

<style>
  .project-stage {
    position: relative;
    min-height: 23rem;
    overflow: hidden;
    isolation: isolate;
  }

  .project-stage::before,
  .project-stage::after {
    position: absolute;
    inset-block: 0;
    z-index: 4;
    width: 8%;
    content: '';
    pointer-events: none;
  }

  .project-stage::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-bg), transparent);
  }

  .project-stage::after {
    right: 0;
    background: linear-gradient(-90deg, var(--color-bg), transparent);
  }

  .project-card {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    width: min(70%, 37rem);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.75rem;
    background: var(--color-surface-2);
    opacity: 0;
    filter: blur(1.5px) brightness(0.76);
    transform: translateX(-50%) scale(0.86);
    transition:
      transform 650ms var(--ease-out-expo),
      opacity 500ms ease,
      filter 650ms var(--ease-out-expo);
    pointer-events: none;
  }

  .project-card[data-state='active'] {
    z-index: 3;
    opacity: 1;
    filter: none;
    transform: translateX(-50%) scale(1);
    pointer-events: auto;
  }

  .project-card[data-state='prev'] {
    z-index: 2;
    opacity: 0.68;
    transform: translateX(-112%) scale(0.86);
  }

  .project-card[data-state='next'] {
    z-index: 2;
    opacity: 0.68;
    transform: translateX(12%) scale(0.86);
  }

  .project-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11rem;
    height: 11rem;
    border: 1px solid rgb(245 245 245 / 0.32);
    border-radius: 42% 58% 64% 36% / 52% 38% 62% 48%;
    background:
      radial-gradient(circle at 34% 30%, rgb(245 245 245 / 0.8), transparent 18%),
      radial-gradient(circle at 58% 62%, rgb(245 245 245 / 0.38), transparent 48%);
    box-shadow:
      inset 0 0 2rem rgb(245 245 245 / 0.22),
      0 0 2.5rem rgb(245 245 245 / 0.16);
    transform: translate(-50%, -50%) rotate(-18deg);
  }

  .project-orb--small {
    top: 68%;
    left: 30%;
    width: 4rem;
    height: 4rem;
    opacity: 0.45;
    filter: blur(2px);
    transform: translate(-50%, -50%) rotate(22deg);
  }

  .project-control {
    position: absolute;
    top: 50%;
    z-index: 6;
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgb(18 18 18 / 0.84);
    color: var(--color-ink);
    backdrop-filter: blur(8px);
    transform: translateY(-50%);
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      transform 350ms var(--ease-out-expo);
  }

  .project-control:hover {
    border-color: rgb(245 245 245 / 0.36);
    background: var(--color-surface);
    transform: translateY(-50%) scale(1.06);
  }

  .project-control--prev {
    left: 0.75rem;
  }

  .project-control--next {
    right: 0.75rem;
  }

  .project-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--color-muted);
    opacity: 0.35;
    transition:
      width 350ms var(--ease-out-expo),
      opacity 250ms ease;
  }

  .project-dot.is-active {
    width: 1.25rem;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .project-stage {
      min-height: 34rem;
    }

    .project-card {
      width: 82%;
    }

    .project-card[data-state='prev'] {
      transform: translateX(-119%) scale(0.88);
    }

    .project-card[data-state='next'] {
      transform: translateX(19%) scale(0.88);
    }

    .project-control {
      top: auto;
      bottom: 1rem;
      width: 2.8rem;
      height: 2.8rem;
      transform: none;
    }

    .project-control:hover {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-control,
    .project-dot {
      transition-duration: 0.01ms;
    }
  }
</style>
